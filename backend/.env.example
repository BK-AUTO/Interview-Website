# Flask secrets — generate real random values for production, never reuse the defaults in app.py
SECRET_KEY=
JWT_SECRET_KEY=

# Authentik SSO (OIDC). Create an OAuth2/OpenID Provider + Application in
# Authentik admin (sso.bkauto.vn) with redirect URI = AUTHENTIK_REDIRECT_URI below.
# Access to this app is controlled by the policy bound to the Application in
# Authentik — this backend does not check group/role membership.
AUTHENTIK_ISSUER=https://sso.bkauto.vn/application/o/<slug>
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_REDIRECT_URI=http://localhost:5000/api/auth/callback
FRONTEND_URL=http://localhost:5173

# Origins allowed to POST to the public /api/apply (Website recruitment form).
# Comma-separated. All other /api/* routes stay open ("*") as before.
WEBSITE_ORIGINS=https://bkauto.vn,http://localhost:5173

# Interview session info text shown to candidates on the confirmation page (/confirm/<token>).
INTERVIEW_SESSION_INFO=8:00 Chủ nhật tại Nhà Khung, ĐH Bách Khoa Hà Nội

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=bkauto.ste@gmail.com
SENDER_PASSWORD=gokc piof wspg vsgr
